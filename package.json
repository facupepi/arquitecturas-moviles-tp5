{
  "name": "san-francisco-conecta-tp5",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emuladores": "node scripts/emuladores.mjs",
    "build": "vite build && node scripts/presupuesto.mjs",
    "preview": "vite preview",
    "test": "node scripts/verificar-rn.mjs && node --test tests/unidad/*.test.mjs",
    "test:reglas": "node scripts/con-emuladores.mjs \"node --test --test-concurrency=1 tests/reglas/*.test.mjs\"",
    "test:e2e": "playwright test --config playwright.config.mjs",
    "e2e:compartido": "node scripts/emuladores.mjs --compartido",
    "e2e:compartido:apagar": "node scripts/emuladores.mjs --apagar",
    "e2e:vite": "node scripts/emuladores.mjs --vite",
    "e2e:vite:apagar": "node scripts/emuladores.mjs --apagar-vite",
    "e2e:agente": "node scripts/emuladores.mjs --playwright",
    "e2e:puertos": "node scripts/emuladores.mjs --puertos",
    "test:humo": "playwright test --config playwright.humo.config.mjs",
    "test:carga": "node tests/carga/medir-carga.mjs",
    "test:todo": "npm test && npm run test:reglas && npm run build && npm run test:e2e",
    "sembrar:emulador": "node scripts/sembrar.mjs --emulador",
    "sembrar:produccion": "node scripts/sembrar.mjs --produccion",
    "capturas": "node scripts/capturas.mjs",
    "deploy:reglas": "firebase deploy --only firestore",
    "deploy:remoteconfig": "firebase deploy --only remoteconfig",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:supabase": "supabase db push && supabase functions deploy vecino adjuntos despachar tareas --use-api",
    "deploy": "npm run deploy:reglas && npm run deploy:remoteconfig && npm run deploy:hosting && npm run deploy:supabase"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "4.7.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.30.0",
    "supabase": "2.120.0",
    "vite": "6.4.1",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
