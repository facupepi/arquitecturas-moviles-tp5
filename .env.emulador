# Modo "emulador" (npm run dev:emuladores → vite --mode emulador). Sin secretos: se versiona.
# Pisa los valores de .env.local; los que quedan vacíos apagan App Check, Analytics y push.
VITE_USAR_EMULADORES=true
VITE_FIREBASE_PROJECT_ID=demo-conecta-tp5
VITE_FIREBASE_API_KEY=demo-clave
VITE_FIREBASE_AUTH_DOMAIN=demo-conecta-tp5.firebaseapp.com
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=
VITE_PUERTO_AUTH=9099
VITE_PUERTO_FIRESTORE=8085
VITE_SUPABASE_URL=http://127.0.0.1:8787
